# ============================================================
# Avança Imóveis — variáveis de ambiente
# Copie para .env.local e preencha. Nunca versione .env.local.
# ============================================================

# --- App ---
# URL pública do site (sem barra no final). Em produção: https://avanca-imoveis.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Postgres + Auth) ---
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Somente no servidor (Server Actions / rotas). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Connection string do Postgres (Supabase > Project Settings > Database > Connection string > "URI").
# Use a porta 6543 (pooler) para runtime serverless e 5432 para migrations.
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Cloudflare R2 (fotos e documentos, S3-compatível) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="avanca-imoveis"
# Host público do bucket (r2.dev ou domínio próprio) — usado para montar as URLs das imagens.
R2_PUBLIC_HOST="https://pub-xxxxxxxx.r2.dev"

# --- E-mail transacional (Resend) — aviso de novo lead. Opcional na Fase 1. ---
RESEND_API_KEY=""
LEADS_NOTIFY_TO="rogerio@exemplo.com,fernanda@exemplo.com"
LEADS_NOTIFY_FROM="Avança Imóveis <no-reply@avanca-imoveis.com>"
