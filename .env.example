# ============================================================
# Avança Imóveis — variáveis de ambiente
# Copie para .env.local e ajuste. Nunca versione .env.local.
# ============================================================

# URL pública do site (sem barra no final).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Banco de dados (Postgres dedicado) ---
# Local, via docker-compose (npm run db:up):
DATABASE_URL="postgresql://avanca:avanca@localhost:5432/avanca"
# Opcional: conexão usada só nas migrations (default = DATABASE_URL).
# Preencha se a produção usar um pooler em modo transação.
DIRECT_URL=""

# --- Autenticação (própria, sem serviço externo) ---
# Tempero opcional do hash de senha. Gere com: openssl rand -hex 32
AUTH_PEPPER=""
# Tempero do hash de IP (contador de views) — gere com o mesmo comando acima.
# Propositalmente separado do AUTH_PEPPER (domínios de segurança diferentes).
# Se deixado em branco, usa o AUTH_PEPPER como fallback.
IP_HASH_PEPPER=""

# --- Fotos e documentos (disco local) ---
# Em produção, aponte para um volume persistente (ex.: /data/uploads).
STORAGE_DIR="./storage/uploads"

# --- E-mail (Resend) — opcional. Sem isso, e-mails só ficam no console. ---
# RESEND_API_KEY sozinho já liga os alertas de busca (envia pro e-mail do
# visitante). LEADS_NOTIFY_TO também liga o aviso de novo lead pra equipe.
RESEND_API_KEY=""
LEADS_NOTIFY_TO=""
LEADS_NOTIFY_FROM=""
